{
  "name": "assistant",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "kill-port 3000 5173 5174 5175 || true && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}
# ==============================================================================
# 🚀 PRODUCTION GRADE ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# This is a template file. Duplicate it as `.env` and fill in your secrets.
# NEVER commit `.env` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔧 APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="development"        # production | development | test
APP_NAME="Assistant App"
APP_VERSION="1.0.0"
DEBUG="True"

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONNECTIONS (PostgreSQL, MySQL, SQLite, etc.)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/assistant_db"
TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"

# ------------------------------------------------------------------------------
# 🧠 REDIS / CACHING / CELERY
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_PER_MINUTE="60"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a secure key using: `openssl rand -hex 32`
SECRET_KEY="super-secret-production-key-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# CORS configuration (comma separated list of allowed origins)
# Add all frontend URLs that need to communicate with the API
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:5174"]'

# ------------------------------------------------------------------------------
# 🌐 FRONTEND / CLIENT URLs
# ------------------------------------------------------------------------------
# Admin Dashboard (Vite)
VITE_ADMIN_URL="http://localhost:5173"
VITE_API_URL="http://localhost:8000/api"

# User Dashboard (Vite)
VITE_USER_URL="http://localhost:5174"

# Marketing Website (Vite)
VITE_WEB_URL="http://localhost:5175"

# Docs Site (Next.js)
NEXT_PUBLIC_DOCS_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# ------------------------------------------------------------------------------
# ☁️ CLOUD / THIRD-PARTY APIs (Stripe, AWS, SendGrid, etc.)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# SENDGRID_API_KEY="SG..."
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME="my-app-assets"

